#!/usr/bin/env python3
import curses
import subprocess
import threading
import time
import os
import shutil
import re

# Regex compile target to instantly scrub ANSI escape codes/color sequences
ANSI_CLEANER = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

# Failure keywords to scan logs for hidden errors
ERROR_KEYWORDS = ["error:", "failed to", "target not found", "conflict", "unable to", "could not"]

# Global dictionary to store log outputs, execution state, and scrolling offsets
streams = {
    "Core Upgrade": {"log": ["Waiting to spin up..."], "status": "PENDING", "color": 4, "scroll_idx": 0, "autoscroll": True},
    "Snap Refresh": {"log": ["Idle..."], "status": "PENDING", "color": 4, "scroll_idx": 0, "autoscroll": True},
    "Flatpak Apps": {"log": ["Idle..."], "status": "PENDING", "color": 4, "scroll_idx": 0, "autoscroll": True},
    "AUR Packages": {"log": ["Idle..."], "status": "PENDING", "color": 4, "scroll_idx": 0, "autoscroll": True}
}

quadrant_order = ["Core Upgrade", "Snap Refresh", "Flatpak Apps", "AUR Packages"]
focused_idx = 0

lock = threading.Lock()
pipeline_finished = False
trigger_cleanup = False

def detect_os():
    if os.path.exists("/etc/arch-release"): return "arch"
    if os.path.exists("/etc/fedora-release") or os.path.exists("/etc/nobara-release"): return "fedora"
    if os.path.exists("/etc/debian_version"): return "debian"
    return "unknown"

def run_task(name, command):
    global streams
    with lock:
        streams[name]["status"] = "RUNNING"
        streams[name]["color"] = 6 # Cyan
        streams[name]["log"] = ["Task started..."]

    failed_by_log = False

    try:
        # Run with standard error redirected to standard output so we catch everything
        proc = subprocess.Popen(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

        while True:
            line = proc.stdout.readline()
            if not line:
                break

            clean_line = ANSI_CLEANER.sub('', line).strip()

            if clean_line:
                # Scan the line for explicit error triggers
                lower_line = clean_line.lower()
                if any(kw in lower_line for kw in ERROR_KEYWORDS):
                    failed_by_log = True

                with lock:
                    streams[name]["log"].append(clean_line)
                    if len(streams[name]["log"]) > 500:
                        streams[name]["log"].pop(0)

                    if streams[name]["autoscroll"]:
                        streams[name]["scroll_idx"] = max(0, len(streams[name]["log"]) - 1)

        proc.stdout.close()
        return_code = proc.wait()

        with lock:
            # Task is only a SUCCESS if the return code is 0 AND no error keywords were flagged
            if return_code == 0 and not failed_by_log:
                streams[name]["status"] = "SUCCESS"
                streams[name]["color"] = 3 # Green
            else:
                streams[name]["status"] = "FAILED"
                streams[name]["color"] = 2 # Red
                if failed_by_log and return_code == 0:
                    streams[name]["log"].append("⚠️ Notice: Internal execution anomaly detected in logs.")
    except Exception as e:
        with lock:
            streams[name]["status"] = "ERROR"
            streams[name]["color"] = 2
            streams[name]["log"].append(str(e))

def execution_pipeline():
    global pipeline_finished
    os_type = detect_os()

    core_cmd = "echo 'Unsupported OS distribution pipeline.'"
    if os_type == "arch": core_cmd = "sudo pacman -Syu --noconfirm"
    elif os_type == "fedora": core_cmd = "sudo dnf upgrade --refresh -y"
    elif os_type == "debian": core_cmd = "sudo apt-get update && sudo apt-get dist-upgrade -y"

    run_task("Core Upgrade", core_cmd)

    threads = []
    if shutil.which("snap"):
        t = threading.Thread(target=run_task, args=("Snap Refresh", "sudo snap refresh"))
        threads.append(t)
    else:
        streams["Snap Refresh"]["status"] = "SKIPPED"
        streams["Snap Refresh"]["color"] = 5

    if shutil.which("flatpak"):
        t = threading.Thread(target=run_task, args=("Flatpak Apps", "flatpak update -y"))
        threads.append(t)
    else:
        streams["Flatpak Apps"]["status"] = "SKIPPED"
        streams["Flatpak Apps"]["color"] = 5

    if os_type == "arch" and shutil.which("yay"):
        t = threading.Thread(target=run_task, args=("AUR Packages", "yay -Sua --noconfirm"))
        threads.append(t)
    else:
        streams["AUR Packages"]["status"] = "SKIPPED"
        streams["AUR Packages"]["color"] = 5

    for t in threads: t.start()
    for t in threads: t.join()

    with lock:
        pipeline_finished = True

def draw_box(stdscr, y, x, h, w, title, color_pair, is_focused, has_up, has_down):
    attrs = curses.color_pair(color_pair)
    if is_focused:
        attrs |= curses.A_BOLD

    stdscr.attron(attrs)
    for i in range(x, x + w):
        stdscr.addch(y, i, '─')
        stdscr.addch(y + h, i, '─')
    for i in range(y, y + h):
        stdscr.addch(i, x, '│')
        stdscr.addch(i, x + w, '│')
    stdscr.addch(y, x, '┌')
    stdscr.addch(y, x + w, '┐')
    stdscr.addch(y + h, x, '└')
    stdscr.addch(y + h, x + w, '┘')

    if has_up:
        stdscr.addch(y + 1, x + w, '▲', curses.A_REVERSE | curses.color_pair(6))
    if has_down:
        stdscr.addch(y + h - 1, x + w, '▼', curses.A_REVERSE | curses.color_pair(6))

    decorator = "► " if is_focused else "┤ "
    closing_dec = " ◄" if is_focused else " ├"
    stdscr.addstr(y, x + 2, f"{decorator}{title}{closing_dec}", attrs)
    stdscr.attroff(attrs)

def get_next_valid_focus(current_idx, forward=True):
    step = 1 if forward else -1
    next_idx = current_idx

    for _ in range(len(quadrant_order)):
        next_idx = (next_idx + step) % len(quadrant_order)
        name = quadrant_order[next_idx]
        if streams[name]["status"] != "SKIPPED":
            return next_idx

    return current_idx

def main(stdscr):
    global pipeline_finished, trigger_cleanup, focused_idx
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.keypad(True)

    curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_RED, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(4, curses.COLOR_BLUE, curses.COLOR_BLACK)
    curses.init_pair(5, curses.COLOR_YELLOW, curses.COLOR_BLACK)
    curses.init_pair(6, curses.COLOR_CYAN, curses.COLOR_BLACK)

    threading.Thread(target=execution_pipeline, daemon=True).start()
    time.sleep(0.05)

    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        if h < 25 or w < 80:
            stdscr.addstr(0, 0, "Terminal too small! Resize to at least 80x25.", curses.color_pair(2))
            stdscr.refresh()
            time.sleep(0.5)
            continue

        stdscr.addstr(0, 2, " casca-system-updater 🗲 Parallel Pipeline System Manager ", curses.A_REVERSE | curses.A_BOLD | curses.color_pair(6))

        box_h = (h - 4) // 2
        box_w = w // 2

        quadrants = [
            ("Core Upgrade", 1, 0),
            ("Snap Refresh", 1, box_w),
            ("Flatpak Apps", 1 + box_h, 0),
            ("AUR Packages", 1 + box_h, box_w)
        ]

        with lock:
            if streams[quadrant_order[focused_idx]]["status"] == "SKIPPED":
                focused_idx = get_next_valid_focus(focused_idx, forward=True)

        current_focus_name = quadrant_order[focused_idx]

        with lock:
            for name, start_y, start_x in quadrants:
                data = streams[name]
                is_focused = (name == current_focus_name)

                content_h = box_h - 1
                content_w = box_w - 4
                total_lines = len(data["log"])

                max_view_start = max(0, total_lines - content_h)
                start_line = min(data["scroll_idx"], max_view_start)

                if data["scroll_idx"] >= max_view_start:
                    data["autoscroll"] = True

                end_line = start_line + content_h
                visible_logs = data["log"][start_line:end_line]

                has_up = start_line > 0 and data["status"] != "SKIPPED"
                has_down = end_line < total_lines and data["status"] != "SKIPPED"

                box_color = 6 if is_focused and data["status"] == "RUNNING" else data["color"]

                draw_box(stdscr, start_y, start_x, box_h, box_w - 1,
                         f"{name} [{data['status']}]" + (" (PAUSED)" if not data["autoscroll"] and data["status"] != "SKIPPED" else ""),
                         box_color, is_focused, has_up, has_down)

                for idx, log_line in enumerate(visible_logs):
                    print_y = start_y + 1 + idx
                    print_x = start_x + 2
                    stdscr.addstr(print_y, print_x, log_line[:content_w], curses.color_pair(1))

        menu_y = h - 1
        stdscr.move(menu_y, 0)
        stdscr.clrtoeol()

        if pipeline_finished:
            stdscr.addstr(menu_y, 2, " X ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 6, "Exit", curses.color_pair(1))
            stdscr.addstr(menu_y, 20, " V ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 24, "Cleanup & exit", curses.color_pair(1))
        else:
            stdscr.addstr(menu_y, 2, " Q ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 6, "Abort", curses.color_pair(2))

        stdscr.addstr(menu_y, 42, " TAB ", curses.A_REVERSE | curses.A_BOLD)
        stdscr.addstr(menu_y, 48, f"Switch Window Focus ({current_focus_name})", curses.color_pair(6))

        stdscr.refresh()
        time.sleep(0.05)

        try:
            ch = stdscr.getch()
            if ch != -1:
                if ch == 9:
                    focused_idx = get_next_valid_focus(focused_idx, forward=True)
                    continue

                f_name = quadrant_order[focused_idx]
                f_data = streams[f_name]
                max_scroll_limit = max(0, len(f_data["log"]) - (box_h - 1))

                if ch == curses.KEY_UP:
                    f_data["autoscroll"] = False
                    f_data["scroll_idx"] = max(0, f_data["scroll_idx"] - 1)
                elif ch == curses.KEY_DOWN:
                    f_data["scroll_idx"] = min(max_scroll_limit, f_data["scroll_idx"] + 1)
                    if f_data["scroll_idx"] >= max_scroll_limit:
                        f_data["autoscroll"] = True
                elif ch == curses.KEY_PPAGE:
                    f_data["autoscroll"] = False
                    f_data["scroll_idx"] = max(0, f_data["scroll_idx"] - (box_h - 2))
                elif ch == curses.KEY_NPAGE:
                    f_data["scroll_idx"] = min(max_scroll_limit, f_data["scroll_idx"] + (box_h - 2))
                    if f_data["scroll_idx"] >= max_scroll_limit:
                        f_data["autoscroll"] = True

                if ch in [ord('q'), ord('Q')] and not pipeline_finished:
                    break
                elif pipeline_finished:
                    if ch in [ord('x'), ord('X')]:
                        break
                    elif ch in [ord('v'), ord('V')]:
                        trigger_cleanup = True
                        break
        except:
            pass

if __name__ == "__main__":
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass

    os_type = detect_os()
    if trigger_cleanup:
        print("\n🧼 Purging orphaned dependencies from the system layout...")
        if os_type == "arch":
            os.system("[ -n \"$(pacman -Qtdq)\" ] && sudo pacman -Rns $(pacman -Qtdq) --noconfirm || echo '✨ No orphans found to remove.'")
        elif os_type == "fedora":
            os.system("sudo dnf autoremove -y")
        elif os_type == "debian":
            os.system("sudo apt-get autoremove -y")
        print("✅ Orphan cleanup complete.")
    else:
        print("\n⏭️ Skipping orphan cleanup phase.")

    print("⚔️ All operational phases finished successfully!")
