#!/usr/bin/env python3
import curses
import subprocess
import threading
import time
import os
import shutil
import re
import sys

# ==============================================================================
# CLI Sudo Safety Sanity Intercept Validation
# ==============================================================================
if os.geteuid() != 0:
    print("❌ Error: casca requires administrative root privileges to execute system maintenance pipelines.")
    print("👉 Please invoke using: sudo casca")
    sys.exit(1)

# Regex compile target to instantly scrub ANSI escape codes/color sequences
ANSI_CLEANER = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

# Failure keywords to scan logs for hidden errors
ERROR_KEYWORDS = ["error:", "failed to", "target not found", "conflict", "unable to", "could not"]

# Global dictionary to store log outputs, execution state, and scrolling offsets
# PENDING state initialized with color pair 5 (Amber/Yellow)
streams = {
    "Core Upgrade": {"log": ["Waiting to spin up..."], "status": "PENDING", "color": 5, "scroll_idx": 0, "autoscroll": True},
    "Snap Refresh": {"log": ["Idle..."], "status": "PENDING", "color": 5, "scroll_idx": 0, "autoscroll": True},
    "Flatpak Apps": {"log": ["Idle..."], "status": "PENDING", "color": 5, "scroll_idx": 0, "autoscroll": True},
    "AUR Packages": {"log": ["Idle..."], "status": "PENDING", "color": 5, "scroll_idx": 0, "autoscroll": True}
}

# Subsystem check results populated before execution pipeline starts
subsystems = {
    "snap": False,
    "flatpak": False,
    "yay": False
}

# Dynamic interface layout ordering tracking
visible_quadrants = []
focused_idx = 0

lock = threading.Lock()
pipeline_finished = False
trigger_cleanup = False

def detect_os():
    if os.path.exists("/etc/arch-release"): return "arch"
    if os.path.exists("/etc/fedora-release") or os.path.exists("/etc/nobara-release"): return "fedora"
    if os.path.exists("/etc/debian_version"): return "debian"
    return "unknown"

def check_subsystems():
    """ Scans the target host path environment for available auxiliary package managers. """
    global subsystems, visible_quadrants
    os_type = detect_os()
    
    subsystems["snap"] = bool(shutil.which("snap"))
    subsystems["flatpak"] = bool(shutil.which("flatpak"))
    subsystems["yay"] = bool(os_type == "arch" and shutil.which("yay"))
    
    # Core Upgrade is always visible
    visible_list = ["Core Upgrade"]
    if subsystems["snap"]: visible_list.append("Snap Refresh")
    if subsystems["flatpak"]: visible_list.append("Flatpak Apps")
    if subsystems["yay"]: visible_list.append("AUR Packages")
    
    with lock:
        visible_quadrants = visible_list

def run_command(command, run_as_user=False):
    """ Wraps execution strings to target the unprivileged calling user context if needed. """
    sudo_user = os.environ.get("SUDO_USER")
    if run_as_user and sudo_user and sudo_user != "root":
        return f"sudo -u {sudo_user} {command}"
    return command

def run_task(name, command):
    global streams
    with lock:
        streams[name]["status"] = "RUNNING"
        streams[name]["color"] = 6 # Cyan
        streams[name]["log"] = ["Task started..."]

    failed_by_log = False

    try:
        proc = subprocess.Popen(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)

        while True:
            line = proc.stdout.readline()
            if not line:
                break

            clean_line = ANSI_CLEANER.sub('', line).strip()

            if clean_line:
                lower_line = clean_line.lower()
                if any(kw in lower_line for kw in ERROR_KEYWORDS):
                    failed_by_log = True

                with lock:
                    streams[name]["log"].append(clean_line)
                    if len(streams[name]["log"]) > 500:
                        streams[name]["log"].pop(0)

                    if streams[name]["autoscroll"]:
                        streams[name]["scroll_idx"] = max(0, len(streams[name]["log"]) - 1)

        proc.stdout.close()
        return_code = proc.wait()

        with lock:
            if return_code == 0 and not failed_by_log:
                streams[name]["status"] = "SUCCESS"
                streams[name]["color"] = 3 # Green
            else:
                streams[name]["status"] = "FAILED"
                streams[name]["color"] = 2 # Red
                if failed_by_log and return_code == 0:
                    streams[name]["log"].append("⚠️ Notice: Internal execution anomaly detected in logs.")
    except Exception as e:
        with lock:
            streams[name]["status"] = "ERROR"
            streams[name]["color"] = 2
            streams[name]["log"].append(str(e))

def execution_pipeline():
    global pipeline_finished
    os_type = detect_os()

    core_cmd = "echo 'Unsupported OS distribution pipeline.'"
    if os_type == "arch": core_cmd = "pacman -Syu --noconfirm"
    elif os_type == "fedora": core_cmd = "dnf upgrade --refresh -y"
    elif os_type == "debian": core_cmd = "apt-get update && apt-get dist-upgrade -y"

    # Core updates execute immediately with system privileges
    run_task("Core Upgrade", run_command(core_cmd, run_as_user=False))

    threads = []
    
    # Snap runs with native root permissions
    if subsystems["snap"]:
        t = threading.Thread(target=run_task, args=("Snap Refresh", run_command("snap refresh", run_as_user=False)))
        threads.append(t)

    # Flatpak runs system-wide with native root privileges
    if subsystems["flatpak"]:
        t = threading.Thread(target=run_task, args=("Flatpak Apps", run_command("flatpak update -y", run_as_user=False)))
        threads.append(t)

    # AUR tools (yay) strictly require dynamic user context mapping to avoid blocking
    if subsystems["yay"]:
        t = threading.Thread(target=run_task, args=("AUR Packages", run_command("yay -Sua --noconfirm", run_as_user=True)))
        threads.append(t)

    for t in threads: t.start()
    for t in threads: t.join()

    with lock:
        pipeline_finished = True

def draw_box(stdscr, y, x, h, w, title, color_pair, is_focused, has_up, has_down):
    attrs = curses.color_pair(color_pair)
    if is_focused:
        attrs |= curses.A_BOLD

    stdscr.attron(attrs)
    for i in range(x, x + w):
        stdscr.addch(y, i, '─')
        stdscr.addch(y + h, i, '─')
    for i in range(y, y + h):
        stdscr.addch(i, x, '│')
        stdscr.addch(i, x + w, '│')
    stdscr.addch(y, x, '┌')
    stdscr.addch(y, x + w, '┐')
    stdscr.addch(y + h, x, '└')
    stdscr.addch(y + h, x + w, '┘')

    if has_up:
        stdscr.addch(y + 1, x + w, '▲', curses.A_REVERSE | curses.color_pair(6))
    if has_down:
        stdscr.addch(y + h - 1, x + w, '▼', curses.A_REVERSE | curses.color_pair(6))

    decorator = "► " if is_focused else "┤ "
    closing_dec = " ◄" if is_focused else " ├"
    stdscr.addstr(y, x + 2, f"{decorator}{title}{closing_dec}", attrs)
    stdscr.attroff(attrs)

def main(stdscr):
    global pipeline_finished, trigger_cleanup, focused_idx
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.keypad(True)

    curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_RED, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(4, curses.COLOR_BLUE, curses.COLOR_BLACK)
    curses.init_pair(5, curses.COLOR_YELLOW, curses.COLOR_BLACK) # Amber/Yellow Pair
    curses.init_pair(6, curses.COLOR_CYAN, curses.COLOR_BLACK)

    threading.Thread(target=execution_pipeline, daemon=True).start()
    time.sleep(0.05)

    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        if h < 25 or w < 80:
            stdscr.addstr(0, 0, "Terminal too small! Resize to at least 80x25.", curses.color_pair(2))
            stdscr.refresh()
            time.sleep(0.5)
            continue

        stdscr.addstr(0, 2, " casca-system-updater 🗲 Parallel Pipeline System Manager ", curses.A_REVERSE | curses.A_BOLD | curses.color_pair(6))

        with lock:
            current_quads = list(visible_quadrants)
        
        num_quads = len(current_quads)
        if num_quads == 0:
            time.sleep(0.05)
            continue
            
        if focused_idx >= num_quads:
            focused_idx = 0

        current_focus_name = current_quads[focused_idx]

        usable_h = h - 3
        
        if num_quads == 1:
            quad_layouts = [(current_quads[0], 1, 0, usable_h, w - 1)]
        elif num_quads == 2:
            box_h = usable_h // 2
            quad_layouts = [
                (current_quads[0], 1, 0, box_h, w - 1),
                (current_quads[1], 1 + box_h, 0, usable_h - box_h, w - 1)
            ]
        else:
            box_h = usable_h // 2
            box_w = w // 2
            
            quad_layouts = []
            quad_layouts.append((current_quads[0], 1, 0, box_h, box_w - 1))
            quad_layouts.append((current_quads[1], 1, box_w, box_h, w - box_w - 1))
            
            if num_quads == 3:
                quad_layouts.append((current_quads[2], 1 + box_h, 0, usable_h - box_h, w - 1))
            else:
                quad_layouts.append((current_quads[2], 1 + box_h, 0, usable_h - box_h, box_w - 1))
                quad_layouts.append((current_quads[3], 1 + box_h, box_w, usable_h - box_h, w - box_w - 1))

        with lock:
            for name, start_y, start_x, box_h, box_w in quad_layouts:
                data = streams[name]
                is_focused = (name == current_focus_name)

                content_h = box_h - 1
                content_w = box_w - 3
                total_lines = len(data["log"])

                max_view_start = max(0, total_lines - content_h)
                start_line = min(data["scroll_idx"], max_view_start)

                if data["scroll_idx"] >= max_view_start:
                    data["autoscroll"] = True

                end_line = start_line + content_h
                visible_logs = data["log"][start_line:end_line]

                has_up = start_line > 0
                has_down = end_line < total_lines

                box_color = 6 if is_focused and data["status"] == "RUNNING" else data["color"]

                draw_box(stdscr, start_y, start_x, box_h, box_w,
                         f"{name} [{data['status']}]" + (" (PAUSED)" if not data["autoscroll"] else ""),
                         box_color, is_focused, has_up, has_down)

                for idx, log_line in enumerate(visible_logs):
                    print_y = start_y + 1 + idx
                    print_x = start_x + 2
                    stdscr.addstr(print_y, print_x, log_line[:content_w], curses.color_pair(1))

        menu_y = h - 1
        stdscr.move(menu_y, 0)
        stdscr.clrtoeol()

        if pipeline_finished:
            stdscr.addstr(menu_y, 2, " X ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 6, "Exit", curses.color_pair(1))
            stdscr.addstr(menu_y, 20, " V ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 24, "Cleanup & exit", curses.color_pair(1))
        else:
            stdscr.addstr(menu_y, 2, " Q ", curses.A_REVERSE | curses.A_BOLD)
            stdscr.addstr(menu_y, 6, "Abort", curses.color_pair(2))

        stdscr.addstr(menu_y, 42, " TAB ", curses.A_REVERSE | curses.A_BOLD)
        stdscr.addstr(menu_y, 48, f"Switch Window Focus ({current_focus_name})", curses.color_pair(6))

        stdscr.refresh()
        time.sleep(0.05)

        try:
            ch = stdscr.getch()
            if ch != -1:
                if ch == 9:
                    focused_idx = (focused_idx + 1) % num_quads
                    continue

                f_name = current_focus_name
                f_data = streams[f_name]
                
                active_box_h = [b_h for n, _, _, b_h, _ in quad_layouts if n == f_name][0]
                max_scroll_limit = max(0, len(f_data["log"]) - (active_box_h - 1))

                if ch == curses.KEY_UP:
                    f_data["autoscroll"] = False
                    f_data["scroll_idx"] = max(0, f_data["scroll_idx"] - 1)
                elif ch == curses.KEY_DOWN:
                    f_data["scroll_idx"] = min(max_scroll_limit, f_data["scroll_idx"] + 1)
                    if f_data["scroll_idx"] >= max_scroll_limit:
                        f_data["autoscroll"] = True
                elif ch == curses.KEY_PPAGE:
                    f_data["autoscroll"] = False
                    f_data["scroll_idx"] = max(0, f_data["scroll_idx"] - (active_box_h - 2))
                elif ch == curses.KEY_NPAGE:
                    f_data["scroll_idx"] = min(max_scroll_limit, f_data["scroll_idx"] + (active_box_h - 2))
                    if f_data["scroll_idx"] >= max_scroll_limit:
                        f_data["autoscroll"] = True

                if ch in [ord('q'), ord('Q')] and not pipeline_finished:
                    break
                elif pipeline_finished:
                    if ch in [ord('x'), ord('X')]:
                        break
                    elif ch in [ord('v'), ord('V')]:
                        trigger_cleanup = True
                        break
        except:
            pass

if __name__ == "__main__":
    check_subsystems()
    
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass

    os_type = detect_os()
    if trigger_cleanup:
        print("\n🧼 Purging orphaned dependencies from the system layout...")
        if os_type == "arch":
            os.system("[ -n \"$(pacman -Qtdq)\" ] && pacman -Rns $(pacman -Qtdq) --noconfirm || echo '✨ No orphans found to remove.'")
        elif os_type == "fedora":
            os.system("dnf autoremove -y")
        elif os_type == "debian":
            os.system("apt-get autoremove -y")
        print("✅ Orphan cleanup complete.")
    else:
        print("\n⏭️ Skipping orphan cleanup phase.")

    print("⚔️ All operational phases finished successfully!")